#NPU support
CONFIG_DRM_ACCEL=y
CONFIG_DRM_ACCEL_ROCKET=m
#optee support
CONFIG_TEE=y
CONFIG_OPTEE=y
CONFIG_CMD_OPTEE=y
#Kaslrseed support
CONFIG_RANDOMIZE_BASE=y
CONFIG_SECURITY_DMESG_RESTRICT=y
#debug kernel load
CONFIG_SERIAL_EARLYCON=y
CONFIG_OF_EARLY_FLATTREE=y
CONFIG_EARLY_PRINTK=y

# CONFIG_CPU_FREQ_DEFAULT_GOV_ONDEMAND is not set
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y

CONFIG_THERMAL_GOV_BANG_BANG=y
CONFIG_SENSORS_GPIO_FAN=y

CONFIG_KEYBOARD_GPIO=y
CONFIG_KEYBOARD_GPIO_POLLED=y

CONFIG_MMC_SDHCI_OF_DWCMSHC=y

# CONFIG_DW_WATCHDOG is not set


# Differences from Armbian
CONFIG_MFD_ROCKCHIP_MFPWM=y
CONFIG_VIDEO_ROCKCHIP_IEP=m
CONFIG_ROCKCHIP_DW_DP=y
CONFIG_ROCKCHIP_DW_HDMI_QP=y
CONFIG_ROCKCHIP_DW_MIPI_DSI2=y
CONFIG_SND_SOC_ROCKCHIP_SAI=m
CONFIG_SCSI_UFS_ROCKCHIP=y
CONFIG_PWM_ROCKCHIP_V4=y
CONFIG_PHY_ROCKCHIP_INNO_USB3=y
CONFIG_PHY_ROCKCHIP_SAMSUNG_DCPHY=m
CONFIG_PHY_ROCKCHIP_SAMSUNG_HDPTX=m
CONFIG_PHY_ROCKCHIP_USBDP=y
CONFIG_CRYPTO_DEV_ROCKCHIP_TRNG=y
CONFIG_CRYPTO_DEV_ROCKCHIP_DEBUG=y
CONFIG_CRYPTO_DEV_ROCKCHIP2=m
CONFIG_CRYPTO_DEV_ROCKCHIP2_DEBUG=y

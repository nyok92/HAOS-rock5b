> > =C2=A0	mutex_init(&rga->mutex);
> > =C2=A0
> > -	ret =3D rga_parse_dt(rga);
> > +	core =3D devm_kzalloc(&pdev->dev, sizeof(*core), GFP_KERNEL);
> > +	core->rga =3D rga;

 		.postprocessed = true,
 		.frmsize = {
 			.min_width = ROCKCHIP_VPU981_MIN_SIZE,
-			.max_width = FMT_4K_WIDTH,
+			.max_width = FMT_8K_WIDTH,
 			.step_width = MB_DIM,
 			.min_height = ROCKCHIP_VPU981_MIN_SIZE,
-			.max_height = FMT_4K_HEIGHT,
+			.max_height = FMT_8K_HEIGHT,
 			.step_height = MB_DIM,
 		},

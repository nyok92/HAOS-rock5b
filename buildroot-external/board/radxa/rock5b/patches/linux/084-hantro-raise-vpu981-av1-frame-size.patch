 #define FMT_UHD_HEIGHT		2160
 #define FMT_4K_WIDTH		4096
 #define FMT_4K_HEIGHT		2304
+#define FMT_8K_WIDTH		8192
+#define FMT_8K_HEIGHT		4352
 
 #define NUM_REF_PICTURES	(V4L2_HEVC_DPB_ENTRIES_NUM_MAX + 1)
 
